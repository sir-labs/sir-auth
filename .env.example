POSTGRES_PASSWORD=change-me
# Password must match POSTGRES_PASSWORD; host is the compose service name.
DATABASE_URL=postgres://sirauth:change-me@sir-auth-db:5432/sirauth?sslmode=disable
JWT_SECRET=change-me-long-random-string
SETUP_SECRET=change-me-setup-secret
COOKIE_DOMAIN=.sir-labs.com
# Go duration syntax (168h = 7 days; "7d" is not valid)
SESSION_TTL=168h
ALLOW_REGISTER=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
